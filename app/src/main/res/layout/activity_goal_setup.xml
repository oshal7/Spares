<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="28dp"
    android:gravity="center_vertical">

    <!-- Logo / App Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SPARES"
        android:textColor="@color/accent_green"
        android:textSize="36sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Micro-savings from every transaction."
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:layout_marginBottom="48dp" />

    <!-- Goal Title Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:hint="What are you saving for?"
        app:boxBackgroundColor="@color/card_dark"
        app:boxBackgroundMode="filled"
        app:hintTextColor="@color/text_secondary"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_goal_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:maxLength="40"
            android:inputType="textCapSentences|textNoSuggestions" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Target Amount Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:hint="Target amount (₹)"
        app:boxBackgroundColor="@color/card_dark"
        app:boxBackgroundMode="filled"
        app:hintTextColor="@color/text_secondary"
        app:prefixText="₹ "
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_goal_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:inputType="numberDecimal" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Create Button -->
    <Button
        android:id="@+id/btn_create_goal"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Set My Goal"
        android:enabled="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/accent_green"
        android:textColor="@color/bg_dark"
        style="@style/Widget.MaterialComponents.Button" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Minimum goal: ₹100"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_gravity="center_horizontal" />

</LinearLayout>
